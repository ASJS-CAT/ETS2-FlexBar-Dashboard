{
  "name": "ETS2 FlexBar Dashboard",
  "uuid": "com.local.ets2rally",
  "version": "1.0.0",
  "author": "ASJS-CAT",
  "entry": "backend/plugin.cjs",
  "description": "DirectDraw ETS2 dashboard with SCS Telemetry and Input SDK controls",
  "repo": "https://github.com/ASJS-CAT/ETS2-FlexBar-Dashboard",
  "sdk": {
    "version": "1.0.9"
  },
  "software": {
    "minimumVersion": "2.0.6"
  },
  "os": [
    {
      "platform": "windows",
      "minimumVersion": "10"
    }
  ],
  "device": [
    {
      "name": "flexbar",
      "version": "1.0.0"
    }
  ],
  "configPage": "global_config",
  "shortcuts": [],
  "keyLibrary": {
    "title": "$PluginName",
    "style": {
      "icon": "mdi mdi-car-speed-limiter"
    },
    "children": [
      {
        "title": "$DashboardTitle",
        "tip": "$DashboardTip",
        "cid": "com.local.ets2rally.dashboard",
        "config": {
          "keyType": "directDraw",
          "platform": [
            "windows"
          ]
        },
        "style": {
          "icon": "mdi mdi-speedometer",
          "width": 2170,
          "showImage": true,
          "showIcon": false,
          "showTitle": false,
          "image": "data:image/png;base64,"
        },
        "data": {}
      }
    ]
  },
  "local": {
    "en": {
      "PluginName": "ETS2 FlexBar Dashboard",
      "DashboardTitle": "ETS2 Dashboard",
      "DashboardTip": "Tap to open the DirectDraw dashboard: driving, controls, information and vehicle motion."
    },
    "zh-CN": {
      "PluginName": "ETS2 FlexBar Dashboard",
      "DashboardTitle": "ETS2 仪表盘",
      "DashboardTip": "点击进入 DirectDraw 仪表盘：驾驶、控制、信息及车辆运动状态。"
    },
    "de": {
      "PluginName": "ETS2 FlexBar Dashboard",
      "DashboardTitle": "ETS2 Dashboard",
      "DashboardTip": "Tap to open the DirectDraw dashboard: driving, controls, information and vehicle motion."
    },
    "fr": {
      "PluginName": "ETS2 FlexBar Dashboard",
      "DashboardTitle": "ETS2 Dashboard",
      "DashboardTip": "Tap to open the DirectDraw dashboard: driving, controls, information and vehicle motion."
    },
    "ja": {
      "PluginName": "ETS2 FlexBar Dashboard",
      "DashboardTitle": "ETS2 Dashboard",
      "DashboardTip": "Tap to open the DirectDraw dashboard: driving, controls, information and vehicle motion."
    },
    "zh-HK": {
      "PluginName": "ETS2 FlexBar Dashboard",
      "DashboardTitle": "ETS2 Dashboard",
      "DashboardTip": "Tap to open the DirectDraw dashboard: driving, controls, information and vehicle motion."
    },
    "ko": {
      "PluginName": "ETS2 FlexBar Dashboard",
      "DashboardTitle": "ETS2 Dashboard",
      "DashboardTip": "Tap to open the DirectDraw dashboard: driving, controls, information and vehicle motion."
    }
  }
}
